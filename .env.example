# ---- Access -----------------------------------------------------------------
# Generate with: openssl rand -base64 32
VIGILO_ADMIN_TOKEN=change-me
# Optional read-only token for wall displays
VIGILO_VIEWER_TOKEN=
VIGILO_HUMAN_NAME=operator
# Public base URL used in setup snippets (e.g. http://vigilo.tailnet-name.ts.net:8088)
VIGILO_PUBLIC_URL=

# ---- Brain (persona generation + autopilot) — any OpenAI-compatible endpoint --
VIGILO_LLM_BASE_URL=
VIGILO_LLM_MODEL=
VIGILO_LLM_API_KEY=
VIGILO_BRAIN_TICK=5
# Max reply depth at which autopilot agents still answer OTHER agents
VIGILO_BRAIN_MAX_DEPTH=4

# ---- Ollama ------------------------------------------------------------------
VIGILO_OLLAMA_URL=
# (VIGILO_LLM_MODEL above is the default model when using Ollama)

# ---- Phone calls (Asterisk ARI) — see docs/asterisk.md --------------------------
VIGILO_ARI_URL=
VIGILO_ARI_USER=vigilo
VIGILO_ARI_PASSWORD=
VIGILO_ARI_APP=vigilo
# How to dial out. Extensions: PJSIP/{to}   Through a trunk: PJSIP/{to}@my-trunk
VIGILO_DIAL_TEMPLATE=PJSIP/{to}
VIGILO_CALLER_ID_NUMBER=7000
# Regex of allowed destinations. Default = internal 2-6 digit extensions only (no toll fraud).
VIGILO_CALL_ALLOW=\d{2,6}
VIGILO_CALLS_PER_HOUR=10
VIGILO_CALL_MAX_TURNS=8
# Which agent answers when the dialplan doesn't name one
VIGILO_PHONE_DEFAULT_AGENT=hermes
# URL Asterisk uses to fetch speech audio from the hub (defaults to VIGILO_PUBLIC_URL)
VIGILO_PHONE_MEDIA_URL=
# Or share a folder with Asterisk instead of HTTP: mount it at /var/lib/asterisk/sounds/vigilo
VIGILO_ASTERISK_SOUNDS_DIR=
# Self-hosted speech, OpenAI-compatible (Speaches, Kokoro-FastAPI, openedai-speech, LocalAI…)
VIGILO_TTS_URL=
VIGILO_TTS_MODEL=kokoro
VIGILO_TTS_VOICE=af_heart
VIGILO_STT_URL=
VIGILO_STT_MODEL=Systran/faster-whisper-small
# Critical alerts phone this number (agent reads the alert and takes questions)
VIGILO_ONCALL_NUMBER=
VIGILO_ONCALL_COOLDOWN_MIN=15

# ---- Guard rails --------------------------------------------------------------
VIGILO_RATE_PER_MIN=30
VIGILO_MAX_REPLY_DEPTH=12
VIGILO_MAX_MESSAGE_CHARS=16000

# ---- Devices (SNMP traps + syslog) -------------------------------------------
VIGILO_LISTENERS=true
VIGILO_AUTO_ONBOARD_DEVICES=true
# Comma-separated allowlist; empty = accept any community
VIGILO_SNMP_COMMUNITIES=
# Keep syslog at or below this severity (0 emerg … 7 debug). 5 = notice and worse.
VIGILO_SYSLOG_MIN_SEVERITY=5

# ---- Host binding (docker-compose). Use your Tailscale IP, e.g. 100.64.0.10 ----
VIGILO_BIND=127.0.0.1
VIGILO_PORT=8088

# ---- Read-only monitoring -------------------------------------------------------
VIGILO_WATCH=true
# Subnets to sweep (read-only) every VIGILO_DISCOVERY_INTERVAL_MIN; new devices raise an alert
VIGILO_DISCOVERY_CIDRS=
VIGILO_DISCOVERY_INTERVAL_MIN=60
VIGILO_DISCOVERY_SNMP_COMMUNITY=public
VIGILO_DISCOVERY_AGENT=scout
VIGILO_CERT_WARN_DAYS=14
VIGILO_HISTORY_DAYS=31
VIGILO_STATUS_TITLE=Service status

# ---- Obsidian vault sync ------------------------------------------------------
# Folder of your vault; notes land in <dir>/Vigilo/. Blank = off.
VIGILO_VAULT_DIR=
VIGILO_VAULT_FOLDER=Vigilo
VIGILO_VAULT_GIT=false
VIGILO_VAULT_GIT_REMOTE=
VIGILO_VAULT_GIT_BRANCH=main
VIGILO_VAULT_INTERVAL=10
VIGILO_VAULT_BACKFILL_DAYS=30
