# ---- Access -----------------------------------------------------------------
# Generate with: openssl rand -base64 32
AGENTCHAT_ADMIN_TOKEN=change-me
# Optional read-only token for wall displays
AGENTCHAT_VIEWER_TOKEN=
AGENTCHAT_HUMAN_NAME=operator
# Public base URL used in setup snippets (e.g. http://agentchat.tailnet-name.ts.net:8088)
AGENTCHAT_PUBLIC_URL=

# ---- Brain (persona generation + autopilot) — any OpenAI-compatible endpoint --
AGENTCHAT_LLM_BASE_URL=
AGENTCHAT_LLM_MODEL=
AGENTCHAT_LLM_API_KEY=
AGENTCHAT_BRAIN_TICK=5
# Max reply depth at which autopilot agents still answer OTHER agents
AGENTCHAT_BRAIN_MAX_DEPTH=4

# ---- Ollama ------------------------------------------------------------------
AGENTCHAT_OLLAMA_URL=
# (AGENTCHAT_LLM_MODEL above is the default model when using Ollama)

# ---- Phone calls (Asterisk ARI) — see docs/asterisk.md --------------------------
AGENTCHAT_ARI_URL=
AGENTCHAT_ARI_USER=agentchat
AGENTCHAT_ARI_PASSWORD=
AGENTCHAT_ARI_APP=agentchat
# How to dial out. Extensions: PJSIP/{to}   Through a trunk: PJSIP/{to}@my-trunk
AGENTCHAT_DIAL_TEMPLATE=PJSIP/{to}
AGENTCHAT_CALLER_ID_NUMBER=7000
# Regex of allowed destinations. Default = internal 2-6 digit extensions only (no toll fraud).
AGENTCHAT_CALL_ALLOW=\d{2,6}
AGENTCHAT_CALLS_PER_HOUR=10
AGENTCHAT_CALL_MAX_TURNS=8
# Which agent answers when the dialplan doesn't name one
AGENTCHAT_PHONE_DEFAULT_AGENT=hermes
# URL Asterisk uses to fetch speech audio from the hub (defaults to AGENTCHAT_PUBLIC_URL)
AGENTCHAT_PHONE_MEDIA_URL=
# Or share a folder with Asterisk instead of HTTP: mount it at /var/lib/asterisk/sounds/agentchat
AGENTCHAT_ASTERISK_SOUNDS_DIR=
# Self-hosted speech, OpenAI-compatible (Speaches, Kokoro-FastAPI, openedai-speech, LocalAI…)
AGENTCHAT_TTS_URL=
AGENTCHAT_TTS_MODEL=kokoro
AGENTCHAT_TTS_VOICE=af_heart
AGENTCHAT_STT_URL=
AGENTCHAT_STT_MODEL=Systran/faster-whisper-small
# Critical alerts phone this number (agent reads the alert and takes questions)
AGENTCHAT_ONCALL_NUMBER=
AGENTCHAT_ONCALL_COOLDOWN_MIN=15

# ---- Guard rails --------------------------------------------------------------
AGENTCHAT_RATE_PER_MIN=30
AGENTCHAT_MAX_REPLY_DEPTH=12
AGENTCHAT_MAX_MESSAGE_CHARS=16000

# ---- Devices (SNMP traps + syslog) -------------------------------------------
AGENTCHAT_LISTENERS=true
AGENTCHAT_AUTO_ONBOARD_DEVICES=true
# Comma-separated allowlist; empty = accept any community
AGENTCHAT_SNMP_COMMUNITIES=
# Keep syslog at or below this severity (0 emerg … 7 debug). 5 = notice and worse.
AGENTCHAT_SYSLOG_MIN_SEVERITY=5

# ---- Host binding (docker-compose). Use your Tailscale IP, e.g. 100.64.0.10 ----
AGENTCHAT_BIND=127.0.0.1
AGENTCHAT_PORT=8088

# ---- Read-only monitoring -------------------------------------------------------
AGENTCHAT_WATCH=true
# Subnets to sweep (read-only) every AGENTCHAT_DISCOVERY_INTERVAL_MIN; new devices raise an alert
AGENTCHAT_DISCOVERY_CIDRS=
AGENTCHAT_DISCOVERY_INTERVAL_MIN=60
AGENTCHAT_DISCOVERY_SNMP_COMMUNITY=public
AGENTCHAT_DISCOVERY_AGENT=scout
AGENTCHAT_CERT_WARN_DAYS=14
AGENTCHAT_HISTORY_DAYS=31
AGENTCHAT_STATUS_TITLE=Service status

# ---- Obsidian vault sync ------------------------------------------------------
# Folder of your vault; notes land in <dir>/AgentSpace/. Blank = off.
AGENTCHAT_VAULT_DIR=
AGENTCHAT_VAULT_FOLDER=AgentSpace
AGENTCHAT_VAULT_GIT=false
AGENTCHAT_VAULT_GIT_REMOTE=
AGENTCHAT_VAULT_GIT_BRANCH=main
AGENTCHAT_VAULT_INTERVAL=10
AGENTCHAT_VAULT_BACKFILL_DAYS=30
